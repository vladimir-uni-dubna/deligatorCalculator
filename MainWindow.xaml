<Window x:Class="deligatorCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор с делегатами" Height="500" Width="350"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Дисплей -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="2" CornerRadius="5" Padding="10">
            <TextBlock x:Name="txtDisplay" 
                       Text="0" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       TextAlignment="Right" 
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Кнопки -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Строка 1: 7 8 9 / -->
            <Button Content="7" Grid.Row="0" Grid.Column="0" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
            <Button Content="8" Grid.Row="0" Grid.Column="1" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
            <Button Content="9" Grid.Row="0" Grid.Column="2" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
            <Button Content="÷" Grid.Row="0" Grid.Column="3" Click="OperationButton_Click" Style="{StaticResource OperationButtonStyle}"/>

            <!-- Строка 2: 4 5 6 × -->
            <Button Content="4" Grid.Row="1" Grid.Column="0" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
            <Button Content="5" Grid.Row="1" Grid.Column="1" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
            <Button Content="6" Grid.Row="1" Grid.Column="2" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
            <Button Content="×" Grid.Row="1" Grid.Column="3" Click="OperationButton_Click" Style="{StaticResource OperationButtonStyle}"/>

            <!-- Строка 3: 1 2 3 - -->
            <Button Content="1" Grid.Row="2" Grid.Column="0" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
            <Button Content="2" Grid.Row="2" Grid.Column="1" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
            <Button Content="3" Grid.Row="2" Grid.Column="2" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
            <Button Content="-" Grid.Row="2" Grid.Column="3" Click="OperationButton_Click" Style="{StaticResource OperationButtonStyle}"/>

            <!-- Строка 4: 0 . C + -->
            <Button Content="0" Grid.Row="3" Grid.Column="0" Click="NumberButton_Click" Style="{StaticResource NumberButtonStyle}"/>
            <Button Content="." Grid.Row="3" Grid.Column="1" Click="DecimalButton_Click" Style="{StaticResource NumberButtonStyle}"/>
            <Button Content="C" Grid.Row="3" Grid.Column="2" Click="ClearButton_Click" Style="{StaticResource ClearButtonStyle}"/>
            <Button Content="+" Grid.Row="3" Grid.Column="3" Click="OperationButton_Click" Style="{StaticResource OperationButtonStyle}"/>

            <!-- Строка 5: = на всю ширину -->
            <Button Content="=" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Click="EqualsButton_Click" Style="{StaticResource EqualsButtonStyle}"/>
        </Grid>
    </Grid>

    <Window.Resources>
        <!-- Стиль для кнопок с цифрами -->
        <Style x:Key="NumberButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стиль для кнопок операций -->
        <Style x:Key="OperationButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#FFB84D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF9933"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стиль для кнопки очистки -->
        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#FF4D4D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#CC0000"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стиль для кнопки равно -->
        <Style x:Key="EqualsButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#45A049"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
</Window>
